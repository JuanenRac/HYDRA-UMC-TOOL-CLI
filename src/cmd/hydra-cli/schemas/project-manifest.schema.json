{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juanenrac.github.io/HYDRA-UMC-SDK/contracts/json-schema/v1/project-manifest.schema.json",
  "title": "HYDRA-UMC project manifest",
  "description": "Canonical public metadata and compiled-version declaration for one HYDRA-UMC or URTC repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ecosystem",
    "name",
    "version",
    "role",
    "stack",
    "technologies",
    "deployment_target",
    "maturity",
    "family",
    "parent",
    "native_version",
    "build",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "ecosystem": {
      "enum": ["HYDRA-UMC", "URTC"]
    },
    "name": {
      "type": "string",
      "pattern": "^(HYDRA-UMC|URTC)(-[A-Z0-9-]+)?$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(\\.\\d+)?$"
    },
    "role": {
      "enum": ["api", "ui", "cli", "firmware", "library", "service", "tool"]
    },
    "stack": {
      "type": "string",
      "minLength": 1
    },
    "technologies": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "deployment_target": {
      "enum": ["cm5", "user-pc", "mobile", "wearable", "dev-server"]
    },
    "maturity": {
      "enum": ["scaffolding", "functional", "established", "production"]
    },
    "deployment_target_note": {
      "description": "Optional free text that explains a deployment_target value.",
      "type": "string"
    },
    "service": {
      "description": "Optional description of the long-running service this repository installs: its listening port, health path and systemd unit.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "health_path": { "type": "string", "minLength": 1 },
        "systemd_unit": { "type": "string", "minLength": 1 }
      }
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "parent": {
      "type": ["string", "null"]
    },
    "native_version": {
      "description": "Native source used by the repository build to verify the manifest version.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "pattern"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "pattern": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["major", "minor", "patch"],
              "properties": {
                "major": { "type": "string", "minLength": 1 },
                "minor": { "type": "string", "minLength": 1 },
                "patch": { "type": "string", "minLength": 1 },
                "build": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "build": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
